+				// Rejecting them made MOVE.L ([bd.W,A6]),D1 and
+				// MOVE.L ([bd.W=0,A6],od.W=4),D1 take vector 4 where hardware
+				// returns a value.
 				else if (extw[5:4] == 2'b00 || extw[3] ||
-				         extw[2:0] == 3'b100 || (extw[6] && extw[2])) begin
+				         extw[2:0] == 3'b100) begin
 					go_illegal;
 				end
